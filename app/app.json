{
  "expo": {
    "name": "Abyssal",
    "slug": "abyssal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.estebancandioti.abyssal"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#a8c8f0",
          "defaultChannel": "abyssal-reminders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "425a4e71-f135-4627-8410-5e81f2aa0b4e"
      }
    }
  }
}
